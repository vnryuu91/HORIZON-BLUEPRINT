{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Zalo|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|WhatsApp|Pinterest|Googlebot|bingbot|Applebot).*"
        },
        {
          "type": "query",
          "key": "post"
        }
      ],
      "destination": "/api/share.js"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Zalo|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|WhatsApp|Pinterest|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/share.js"
    },
    {
      "source": "/post/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Zalo|Twitterbot|TelegramBot|LinkedInBot|Discordbot|Slackbot|WhatsApp|Pinterest|Googlebot|bingbot|Applebot).*"
        }
      ],
      "destination": "/api/share.js?post=:slug"
    },
    {
      "source": "/post/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|src/|og-default\\.svg|favicon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
